# Turbodrone settings for the Contixo F19 Arvo.
# install.bat copies this file to <turbodrone>\backend\.env

# WiFi UAV app family. Control packets in the layout that already reached the F19.
DRONE_TYPE=wifi_uav

# Ask for video on both ports the WiFi UAV app uses (8801 = newer/dual-camera boards).
WIFI_UAV_VIDEO_PORTS=8800,8801
WIFI_UAV_VIDEO_DEBUG=true

# The drone sends video FROM udp/1234; poke that port first so the phone's NAT and
# Windows Firewall let the video back in.
WIFI_UAV_PUNCH_PORTS=1234

# Starting speed: 0 = Low (30%), 1 = Med (60%), 2 = High (100%).
# Low + precise was too weak on the F19 (pitch/yaw barely reacted); High was too twitchy.
WIFI_UAV_SPEED_INDEX=1

# Climb/descend strength, same scale as above. 1 = 60%: no full-power revving on climbs.
WIFI_UAV_THROTTLE_SPEED_INDEX=1

# Stick feel: precise (gentle), normal, aggressive.
WIFI_UAV_PROFILE=normal

# If turning (yaw) and sliding sideways (roll) feel swapped, change fld to uav.
WIFI_UAV_AXIS_ORDER=fld

# JPEG tables: stock = Turbodrone's fixed quality-50 tables (default). quality = scale them
# to the quality byte in each frame. Unproven on the F19: compare before keeping it.
WIFI_UAV_JPEG_TABLES=stock

# Follow mode (BeaconFollowPlugin, switch it on in the page's Plugins panel after takeoff).
PLUGINS_ENABLED=true
FOLLOW_MAX_YAW=0.35
FOLLOW_MAX_PITCH=0.30
# Hover this long without the beacon, then land.
FOLLOW_LAND_AFTER_LOST_S=6
# Land and wait when the wearer stands still this long (0 = off).
FOLLOW_REST_AFTER_S=20
# 1 = take off again by itself when the wearer moves away. Off until tested.
FOLLOW_RELAUNCH=0
# Back off when something would hit the drone within this many seconds (0 to disable looming: FOLLOW_LOOMING=0).
FOLLOW_TAU_S=1.2
FOLLOW_TARGET_AREA=0.002

# Drift hold (front camera cancels sideways / forward drift; used by HoverHoldPlugin
# and by follow mode). Raise DRIFT_K_ROLL if it still drifts; lower it if it wobbles
# side to side.
DRIFT_K_ROLL=1.2
DRIFT_K_PITCH=0.8
DRIFT_MAX_ROLL=0.20
DRIFT_MAX_PITCH=0.15

# DRONE_IP is set automatically by drone.ps1 from the drone's Wi-Fi gateway.
